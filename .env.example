# Wallet private key for server-side contract interactions
# IMPORTANT: This wallet must have the GAME_ROLE on the contract to call updatePlayerData
# Make sure this wallet has enough RITUAL tokens for gas fees
WALLET_PRIVATE_KEY=

# Signer wallet private key for game contract interactions
# This should be the private key for wallet: 0x74E4E54Ac02C560B3a9C4149cDB8FEeC87457338
# IMPORTANT: Keep this secure and never commit to version control
SIGNER_PRIVATE_KEY=
# Use: openssl rand -hex 32
API_SECRET=some_secret_do_not_expose
NEXT_PUBLIC_CLIENT_API_SECRET=your_client_side_secret_here

# JWT Secret for session management
# Use: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# App Configuration
NEXT_PUBLIC_APP_URL=

# Ritual Chain RPC URLs
NEXT_PUBLIC_RITUAL_RPC_URL=https://rpc.ritualfoundation.org
NEXT_PUBLIC_RITUAL_WS_URL=wss://rpc.ritualfoundation.org/ws

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Development
NEXT_PUBLIC_ENVIRONMENT=development

# Console Logging
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=false